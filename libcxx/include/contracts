#if __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)
#  include <__cxx03/__config>
#else
#  include <__config>

// The dylib is built in an earlier language mode but needs the definitions.
#  if _LIBCPP_STD_VER >= 26 || defined(_LIBCPP_BUILDING_LIBRARY)
#    include <__exception/exception_ptr.h>
#    include <source_location>
#  endif

#  include <version>

#  if !defined(_LIBCPP_HAS_NO_PRAGMA_SYSTEM_HEADER)
#    pragma GCC system_header
#  endif

#  if _LIBCPP_STD_VER >= 26 || defined(_LIBCPP_BUILDING_LIBRARY)

// A node of the chain of data blocks that describes a contract violation, as
// defined by the Itanium C++ Contracts ABI (see <__contracts/abi.h>).
namespace __cxxabiv1 {
struct __cxa_contract_data_block;
}

// std::contracts is deliberately not in the versioning namespace: the Itanium
// C++ Contracts ABI fixes the symbol names of contract_violation's member
// functions (_ZNKSt9contracts18contract_violation...) and of the handler
// replacement mechanism, so that they are the same for every C++ standard
// library implementing the ABI.
_LIBCPP_BEGIN_UNVERSIONED_NAMESPACE_STD

namespace contracts {

enum class assertion_kind : unsigned char { pre = 1, post = 2, assert = 3 };

enum class evaluation_semantic : unsigned char { ignore = 1, observe = 2, enforce = 3, quick_enforce = 4 };

enum class detection_mode : unsigned char { predicate_false = 1, evaluation_exception = 2 };

_LIBCPP_BEGIN_EXPLICIT_ABI_ANNOTATIONS

// A contract_violation is a wrapper around the chain of data blocks that the
// contract-violation runtime passes to the handler. The accessors look the
// information up in the chain, which stays valid for as long as the handler
// runs.
class _LIBCPP_EXPORTED_FROM_ABI _LIBCPP_AVAILABILITY_CONTRACTS contract_violation {
  // No user-accessible constructor. The contract-violation runtime creates
  // objects of this layout (a single pointer to the head of the chain) and
  // passes them to the handler as a contract_violation.
  const __cxxabiv1::__cxa_contract_data_block* __chain_;

  contract_violation() = delete;

public:
  contract_violation(const contract_violation&)            = delete;
  contract_violation& operator=(const contract_violation&) = delete;

  _LIBCPP_HIDE_FROM_ABI ~contract_violation() = default;

  const char* comment() const noexcept;
  contracts::detection_mode detection_mode() const noexcept;
  exception_ptr evaluation_exception() const noexcept;
  bool is_terminating() const noexcept;
  assertion_kind kind() const noexcept;
  source_location location() const noexcept;
  evaluation_semantic semantic() const noexcept;
};

_LIBCPP_AVAILABILITY_CONTRACTS _LIBCPP_EXPORTED_FROM_ABI void
invoke_default_contract_violation_handler(const contract_violation&);

_LIBCPP_END_EXPLICIT_ABI_ANNOTATIONS

} // namespace contracts

_LIBCPP_END_UNVERSIONED_NAMESPACE_STD

#  endif // _LIBCPP_STD_VER >= 26 || defined(_LIBCPP_BUILDING_LIBRARY)
#endif   // __cplusplus < 201103L && defined(_LIBCPP_USE_FROZEN_CXX03_HEADERS)

#endif // _LIBCPP_CONTRACTS
